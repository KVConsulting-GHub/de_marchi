# ─ Firebase (client-side — copiar para NEXT_PUBLIC_*) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─ Firebase Admin (server-side — NUNCA expor no client) ───────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=            # manter as \n literais

# ─ Gemini API ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                        # Google AI Studio → API Keys

# ─ Resend ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=                        # resend.com → API Keys
RESEND_FROM_EMAIL=onboarding@demarchi.com.br

# ─ App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                           # segredo para validar chamadas do Vercel Cron
